{
  "name": "electron-browser-shell",
  "version": "1.0.0",
  "description": "A minimal browser shell built on Electron.",
  "main": "packages/shell/.webpack/main",
  "author": "Samuel Maddock <sam@samuelmaddock.com>",
  "license": "GPL-3.0",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy-html",
    "copy-html": "node scripts/copy-html.js",
    "clean": "rimraf dist",
    "start": "npm run build && cd packages/shell && npm start",
    "start:dev-direct": "npm --prefix packages/shell run start:dev-direct",
    "package": "cd packages/shell && npm run package",
    "package:peserta": "cd packages/shell && npm run package:peserta",
    "package:penguji": "cd packages/shell && npm run package:penguji",
    "package:win32": "npm run package:win32:peserta",
    "package:win32:peserta": "node scripts/package-win.js peserta --arch=ia32",
    "package:win32:penguji": "node scripts/package-win.js penguji --arch=ia32",
    "package:win32:all": "npm run package:win32:peserta && npm run package:win32:penguji",
    "package:win64": "npm run package:win64:peserta",
    "package:win64:peserta": "node scripts/package-win.js peserta --arch=x64",
    "package:win64:penguji": "node scripts/package-win.js penguji --arch=x64",
    "package:mac": "npm run package:mac:peserta",
    "package:mac:peserta": "node scripts/package-mac.js peserta --arm64",
    "package:mac:penguji": "node scripts/package-mac.js penguji --arm64",
    "package:mac-intel": "npm run package:mac-intel:peserta",
    "package:mac-intel:peserta": "node scripts/package-mac.js peserta --x64",
    "package:mac-intel:penguji": "node scripts/package-mac.js penguji --x64",
    "package:mac-universal": "npm run package:mac-universal:peserta",
    "package:mac-universal:peserta": "node scripts/package-mac.js peserta --x64 --arm64",
    "package:mac-universal:penguji": "node scripts/package-mac.js penguji --x64 --arm64",
    "check:mac-icon": "node scripts/create-mac-icon.js",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "user:build": "yarn run build:context-menu && yarn run build:chrome-web-store && yarn run build:extensions && yarn run build:shell",
    "build:chrome-web-store": "yarn --cwd ./packages/electron-chrome-web-store build",
    "build:context-menu": "yarn --cwd ./packages/electron-chrome-context-menu build",
    "build:extensions": "yarn --cwd ./packages/electron-chrome-extensions build",
    "build:shell": "yarn --cwd ./packages/shell build",
    "user:start": "yarn build:context-menu && yarn build:extensions && yarn build:chrome-web-store && yarn --cwd ./packages/shell start",
    "start:debug": "cross-env DEBUG='electron*' yarn start",
    "start:electron-dev": "cross-env ELECTRON_OVERRIDE_DIST_PATH=$(e show out --path) ELECTRON_ENABLE_LOGGING=1 yarn start",
    "start:electron-dev:debug": "cross-env DEBUG='electron*' yarn start:electron-dev",
    "start:electron-dev:trace": "cross-env ELECTRON_OVERRIDE_DIST_PATH=$(e show out --path) ELECTRON_ENABLE_LOGGING=1 yarn --cwd ./packages/shell start:trace",
    "start:skip-build": "cross-env SHELL_DEBUG=true DEBUG='electron-chrome-extensions*' yarn --cwd ./packages/shell start",
    "test": "yarn test:extensions",
    "test:extensions": "yarn --cwd ./packages/electron-chrome-extensions test",
    "postinstall": "npm --prefix packages/shell install",
    "prepare": "husky",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css}\"",
    "generate-noncompliant": "cat noncompliant.txt | awk '{print tolower($0)}' | xargs -I {} node ./scripts/generate-hash.js {}"
  },
  "dependencies": {
    "electron-log": "^5.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "electron": "^32.2.7",
    "electron-builder": "^25.1.8",
    "eslint": "^9.14.0",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.1"
  },
  "build": {
    "appId": "io.kki.app",
    "productName": "KKI Browser",
    "directories": {
      "output": "release",
      "buildResources": "assets",
      "app": "."
    },
    "win": {
      "requestedExecutionLevel": "requireAdministrator",
      "target": [
        "nsis"
      ],
      "icon": "assets/kki-icon.ico",
      "artifactName": "KKI-Browser-${version}-win.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/kki-icon.icns",
      "category": "public.app-category.education",
      "artifactName": "KKI-Browser-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "title": "KKI Browser ${version}",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist/main/main.js"
    }
  },
  "repository": "git@github.com:samuelmaddock/electron-browser-shell.git",
  "engines": {
    "node": ">= 16.0.0",
    "yarn": ">= 1.10.0 < 2.0.0"
  },
  "private": true
}