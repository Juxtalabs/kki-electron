        "message": "Steam download page opened in browser"
      }
    },
    {
      "id": "whatsapp",
      "name": "WhatsApp",
      "enabled": false,
      "style": {
        "backgroundColor": "#25D366",
        "hoverColor": "#20b858",
        "activeColor": "#1a9e4a",
        "textColor": "#ffffff"
      },
      "detection": {
        "type": "executable",
        "paths": [
          "%USERPROFILE%\\AppData\\Local\\WhatsApp\\WhatsApp.exe",
          "%PROGRAMFILES%\\WhatsApp\\WhatsApp.exe"
        ],
        "fallbackCommand": "where whatsapp"
      },
      "launch": {
        "executable": "auto-detected",
        "arguments": []
